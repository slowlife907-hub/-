<!DOCTYPE html>
<html>
<head>
  <title>Eco Sort</title>
  <style>
    #timer { font-size: 24px; color: green; }
    .bin { margin: 10px; padding: 10px; border: 2px solid #000; cursor: pointer; }
  </style>
</head>
<body>
  <h1>เกมแยกขยะเพื่อสิ่งแวดล้อม</h1>
  <div id="timer">เวลา: 45</div>
  <div id="trash"></div>
  <div id="bins">
    <div class="bin" onclick="checkAnswer('ทั่วไป')">ถังทั่วไป</div>
    <div class="bin" onclick="checkAnswer('รีไซเคิล')">ถังรีไซเคิล</div>
    <div class="bin" onclick="checkAnswer('อันตราย')">ถังอันตราย</div>
    <div class="bin" onclick="checkAnswer('เปียก')">ถังเปียก</div>
  </div>

  <script>
    const items = [
      { name: "ขวดน้ำ", type: "รีไซเคิล" },
      { name: "เศษอาหาร", type: "เปียก" },
      { name: "ถ่านไฟฉาย", type: "อันตราย" },
      { name: "ซองขนม", type: "ทั่วไป" }
    ];

    let current = 0;
    let timeLeft = 45;
    let timer;

    function startTimer() {
      timeLeft = 45;
      document.getElementById("timer").innerText = `เวลา: ${timeLeft}`;
      timer = setInterval(() => {
        timeLeft--;
        document.getElementById("timer").innerText = `เวลา: ${timeLeft}`;
        if (timeLeft <= 0) {
          clearInterval(timer);
          alert("หมดเวลา!");
          nextItem();
        }
      }, 1000);
    }

    function showItem() {
      document.getElementById("trash").innerText = `ขยะ: ${items[current].name}`;
      startTimer();
    }

    function checkAnswer(type) {
      clearInterval(timer);
      if (type === items[current].type) {
        alert("ถูกต้อง!");
      } else {
        alert("ผิดนะ! ควรแยกเป็น: " + items[current].type);
      }
      nextItem();
    }

    function nextItem() {
      current++;
      if (current < items.length) {
        showItem();
      } else {
        alert("จบเกมแล้ว! ขอบคุณที่ช่วยโลกสะอาด 🌍");
      }
    }

    showItem();
  </script>
</body>
</html>
